{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo skip install",
  "buildCommand": "bash build.sh",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/(.*)\\.(wasm|pck)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
